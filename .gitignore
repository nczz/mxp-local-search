# OS / editor
.DS_Store
.idea/
.vscode/

# Rust build output
/target/

# Release/build artifacts generated locally
/release/*
*.so
*.dylib
*.dll
*.zip
*.tar.gz
*.tgz
*.sha256
/SHA256SUMS

# Local model bundles and knowledge-base data
/models/*
!/models/.gitkeep
*.onnx
/models/**/tokenizer.json
/models/**/manifest.json
*.usearch
*.sqlite
*.sqlite3
*.db

# WordPress runtime: keep only the MXP plugin source in its current path
/wordpress/*
!/wordpress/wp-content/
/wordpress/wp-content/*
!/wordpress/wp-content/plugins/
/wordpress/wp-content/plugins/*
!/wordpress/wp-content/plugins/mxp-local-search/
!/wordpress/wp-content/plugins/mxp-local-search/**

# WordPress secrets/runtime generated by DDEV or local testing
/wordpress/wp-config.php
/wordpress/wp-config-ddev.php
/wordpress/wp-content/uploads/
/wordpress/wp-content/cache/
/wordpress/wp-content/upgrade/
/wordpress/wp-content/languages/
/wordpress/wp-content/mu-plugins/
/wordpress/wp-content/debug.log

# DDEV generated/runtime files
/.ddev/.gitignore
/.ddev/.ddev-docker-compose-*.yaml
/.ddev/.dbimageBuild/
/.ddev/.webimageBuild/
/.ddev/.homeadditions/
/.ddev/.sshimageBuild/
/.ddev/mutagen/
/.ddev/traefik/certs/
/.ddev/config.local.yaml
/.ddev/config.*.local.yaml
/.ddev/db_snapshots/
/.ddev/.importdb*
/.ddev/.*downloads
/.ddev/apache/apache-site.conf
/.ddev/nginx_full/nginx-site.conf
/.ddev/postgres/postgresql.conf
/.ddev/xhprof/xhprof_prepend.php

# DDEV provider/share templates are local tooling noise for this project
/.ddev/providers/
/.ddev/share-providers/
